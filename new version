local function C_69()
local script = G2L["69"];
	-- Put this script directly INSIDE your main Fly button
	local UIS = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	
	local player = Players.LocalPlayer
	local camera = workspace.CurrentCamera
	
	local gui = script.Parent.Parent
	
	local flyButton   = script.Parent                    
	local speedInput  = gui:WaitForChild("FlSped")
	
	local btn1 = gui:WaitForChild("fl1")
	local btn2 = gui:WaitForChild("fl2")
	local btn3 = gui:WaitForChild("fl3")
	local btn4 = gui:WaitForChild("fl4")
	local btn5 = gui:WaitForChild("fl5")
	local btn6 = gui:WaitForChild("fl6")
	local btn7 = gui:WaitForChild("fl7")
	
	local flying = false
	local flyActive = false
	local bodyVelocity = nil
	local animConnection = nil
	local flyConnection = nil
	
	-- Animation control
	local function setAnims(state)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then return end
	
		if state == false then
			for _, track in pairs(hum:GetPlayingAnimationTracks()) do track:Stop() end
			if not animConnection then
				animConnection = hum.AnimationPlayed:Connect(function(track) track:Stop() end)
			end
		elseif animConnection then
			animConnection:Disconnect()
			animConnection = nil
		end
	end
	
	local function toggleFlyMode(state)
		flyActive = state
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not hum or not root then return end
	
		if flyActive then
			-- START FLYING
			if not hum.SeatPart then
				setAnims(false)
				hum.PlatformStand = true
				hum:ChangeState(Enum.HumanoidStateType.Physics)
			end
	
			bodyVelocity = root:FindFirstChild("FlyVelocity") or Instance.new("BodyVelocity")
			bodyVelocity.Name = "FlyVelocity"
			bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			bodyVelocity.Velocity = Vector3.new(0, 0, 0)
			bodyVelocity.Parent = root
	
			flyConnection = RunService:BindToRenderStep("FlyLoop", Enum.RenderPriority.Camera.Value, function()
				if not bodyVelocity or not bodyVelocity.Parent then return end
	
				if UIS:GetFocusedTextBox() then 
					bodyVelocity.Velocity = Vector3.new(0,0,0) 
					return 
				end
	
				local currentSpeed = tonumber(speedInput.Text) or 60
	
				local direction = Vector3.new(0, 0, 0)
				if UIS:IsKeyDown(Enum.KeyCode.W) then direction += camera.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.S) then direction -= camera.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.A) then direction -= camera.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.D) then direction += camera.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.new(0, 1, 0) end
				if UIS:IsKeyDown(Enum.KeyCode.Q) then direction -= Vector3.new(0, 1, 0) end
	
				root.RotVelocity = Vector3.new(0, 0, 0)
				bodyVelocity.Velocity = direction.Magnitude > 0 and (direction.Unit * currentSpeed) or Vector3.new(0,0,0)
	
				root.CFrame = CFrame.new(root.Position, root.Position + camera.CFrame.LookVector)
			end)
	
		else
			-- STOP FLYING
			if flyConnection then
				RunService:UnbindFromRenderStep("FlyLoop")
				flyConnection = nil
			end
	
			if bodyVelocity then
				bodyVelocity:Destroy()
				bodyVelocity = nil
			end
	
			if hum.SeatPart then
				-- Logic for staying in the seat
				hum.PlatformStand = false
				-- Force the humanoid back into the Seated state so the game knows you're still there
				hum:ChangeState(Enum.HumanoidStateType.Seated) 
			else
				-- Logic for regular standing flight
				setAnims(true)
				hum.PlatformStand = false
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
				task.wait(0.05)
				hum:ChangeState(Enum.HumanoidStateType.Running)
	
				hum.Jump = true
				task.wait(0.03)
				hum.Jump = false
			end
		end
	end
	
	-----------------------------------
	-- BUTTONS
	-----------------------------------
	local function setFlySpeedFromButton(btn)
		if btn.Text and tonumber(btn.Text) then
			speedInput.Text = btn.Text
		else
			speedInput.Text = "60"
		end
	end
	
	btn1.MouseButton1Click:Connect(function() setFlySpeedFromButton(btn1) end)
	btn2.MouseButton1Click:Connect(function() setFlySpeedFromButton(btn2) end)
	btn3.MouseButton1Click:Connect(function() setFlySpeedFromButton(btn3) end)
	btn4.MouseButton1Click:Connect(function() setFlySpeedFromButton(btn4) end)
	btn6.MouseButton1Click:Connect(function() setFlySpeedFromButton(btn6) end)
	btn7.MouseButton1Click:Connect(function() setFlySpeedFromButton(btn7) end)
	
	btn5.MouseButton1Click:Connect(function()
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			speedInput.Text = tostring(math.floor(hum.WalkSpeed))
		else
			speedInput.Text = "16"
		end
	end)
	
	flyButton.MouseButton1Click:Connect(function()
		flying = not flying
		flyButton.Text = flying and "Fly-ON" or "Fly-OFF"
		toggleFlyMode(flying)
	end)
	
	UIS.InputBegan:Connect(function(i, g)
		if not g and i.KeyCode == Enum.KeyCode.LeftAlt and flying then
			flyActive = not flyActive
			toggleFlyMode(flyActive)
		end
	end)
	
	-----------------------------------
	-- RESPAWN LOGIC
	-----------------------------------
	player.CharacterAdded:Connect(function()
		flyActive = false 
	
		if flyConnection then
			RunService:UnbindFromRenderStep("FlyLoop")
			flyConnection = nil
		end
	
		if bodyVelocity then
			bodyVelocity:Destroy()
			bodyVelocity = nil
		end
	end)
end;
