			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
	
	local function startFlying()
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not hum then return end
	
		isFlying = true
		currentTarget = hum.SeatPart or root
	
		bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(1,1,1) * math.huge
		bv.Parent = currentTarget
	
		bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(2,2,2) * math.huge
		bg.P = 3000
		bg.D = 500
		bg.Parent = currentTarget
	
		RunService:BindToRenderStep("UniversalFly", 200, function()
			local speed = tonumber(speedInput.Text) or 60
			local dir = Vector3.new(0,0,0)
	
			-- AUTO-SWITCH: If you jump out of a car, move fly forces to YOU
			if hum.SeatPart == nil and currentTarget ~= root then
				bv.Parent = root
				bg.Parent = root
				currentTarget = root
			end
	
			if not UIS:GetFocusedTextBox() then
				if UIS:IsKeyDown(Enum.KeyCode.W) then dir += camera.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= camera.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= camera.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.D) then dir += camera.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
				if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0,1,0) end
			end
	
			bv.Velocity = dir.Magnitude > 0 and (dir.Unit * speed) or Vector3.new(0,0,0)
	
			-- Q-TILT LOGIC
			if UIS:IsKeyDown(Enum.KeyCode.Q) then
				bg.CFrame = camera.CFrame * CFrame.Angles(math.rad(-90), 0, 0)
			else
				bg.CFrame = camera.CFrame
			end
	
			if not hum.SeatPart then
				hum.PlatformStand = true
			end
		end)
	end
	
	-- Main Button: Arms the script and starts flight
	flyButton.MouseButton1Click:Connect(function()
		if not flyArmed then
			-- Turn it ON
			flyArmed = true
			flyButton.Text = "Fly-ON"
			startFlying()
		else
			-- Turn it OFF completely
			flyArmed = false
			flyButton.Text = "Fly-OFF"
			stopFlying()
		end
	end)
	
	-- Alt Toggle: Only works while flyButton is "Fly-ON"
	UIS.InputBegan:Connect(function(input, p)
		if not p and input.KeyCode == Enum.KeyCode.LeftAlt then
			if flyArmed then
				if isFlying then 
					stopFlying() 
				else 
					startFlying() 
				end
				-- Note: Text does NOT change when using Alt, per your request
			end
		end
	end)
	
	-- Speed Buttons
	local function setSpeed(btn) speedInput.Text = btn.Text end
	
	-- Save speed when manually typed
	speedInput.FocusLost:Connect(function()
		local num = tonumber(speedInput.Text)
		if num then
			speedInput.Text = tostring(num)
		else
			speedInput.Text = tostring(tonumber(speedInput.Text) or 60)
		end
	end)
	btn1.MouseButton1Click:Connect(function() setSpeed(btn1) end)
	btn2.MouseButton1Click:Connect(function() setSpeed(btn2) end)
	btn3.MouseButton1Click:Connect(function() setSpeed(btn3) end)
	btn4.MouseButton1Click:Connect(function() setSpeed(btn4) end)
	btn6.MouseButton1Click:Connect(function() setSpeed(btn6) end)
	btn7.MouseButton1Click:Connect(function() setSpeed(btn7) end)
	btn5.MouseButton1Click:Connect(function() 
		local h = player.Character:FindFirstChild("Humanoid")
		speedInput.Text = h and tostring(math.floor(h.WalkSpeed)) or "16"
	end)
end;
