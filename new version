-- Require G2L wrapper
local G2L_REQUIRE = require;
local G2L_MODULES = {};
local function require(Module:ModuleScript)
    local ModuleState = G2L_MODULES[Module];
    if ModuleState then
        if not ModuleState.Required then
            ModuleState.Required = true;
            ModuleState.Value = ModuleState.Closure();
        end
        return ModuleState.Value;
    end;
    return G2L_REQUIRE(Module);
end

G2L_MODULES[G2L["2"]] = {
Closure = function()
    local script = G2L["2"];local SettingsManager = {}

local EXCLUDED_KEYS = {
	["fps"] = true,
}

local SAVE_KEY = "ChetahsSettings_v1"
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

-- Registered getters: key -> function that returns current value
-- Scripts call register() to tell the system how to read their state
local getters = {}

-- Direct values set via set() method
-- For scripts that prefer setting values explicitly instead of registering getters
local directValues = {}

-- Cache of loaded data to avoid re-reading the file every get() call
local cachedData = nil

-- Register a setting with a function that returns its current value
-- Call this once per setting, right after initializing the variable
function SettingsManager.register(key, getValueFunc)
	getters[key] = getValueFunc
end

-- Set a value directly (alternative to register for simple toggle states)
-- The auto-save loop will pick up these values automatically
function SettingsManager.set(key, value)
	directValues[key] = value
end

-- Collect all current values from registered getters and direct values
local function collectValues()
	local data = {}
	for key, getter in pairs(getters) do
		if not EXCLUDED_KEYS[key] then
			local success, value = pcall(getter)
			if success then
				data[key] = value
			end
		end
	end
	for key, value in pairs(directValues) do
		if not EXCLUDED_KEYS[key] then
			data[key] = value
		end
	end
	return data
end

-- Save current state to file
function SettingsManager.save()
	local data = collectValues()
	pcall(function()
		writefile(SAVE_KEY, HttpService:JSONEncode(data))
	end)
end

-- Load saved data from file (cached after first load)
function SettingsManager.load()
	if cachedData then
		return cachedData
	end
	local success, result = pcall(function()
		if isfile(SAVE_KEY) then
			return HttpService:JSONDecode(readfile(SAVE_KEY))
		end
		return nil
	end)
	if success and result then
		cachedData = result
		return result
	end
	return nil
end

-- Get a specific saved value (used on load to restore state)
function SettingsManager.get(key, default)
	local data = SettingsManager.load()
	if data and data[key] ~= nil then
		return data[key]
	end
	return default
end

-- Force a fresh reload from file (clears cache)
function SettingsManager.reload()
	cachedData = nil
	return SettingsManager.load()
end

-- Auto-save loop: saves every 3 seconds automatically
-- No script ever needs to call save() or set() manually
task.spawn(function()
	while task.wait(3) do
		SettingsManager.save()
	end
end)

-- Save on teleport/leave so no data is lost
local localPlayer = Players.LocalPlayer
if localPlayer then
	localPlayer.OnTeleport:Connect(function()
		SettingsManager.save()
	end)
end

return SettingsManager
end;
