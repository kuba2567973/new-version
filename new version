	local button = script.Parent
	local Players = game:GetService("Players")
	local localPlayer = Players.LocalPlayer
	
	local active = false
	local targetColor = Color3.fromRGB(95, 48, 0)
	local originalColors = {} -- Zde si schováme barvy, abychom je mohli vrátit
	
	-- Smyčka běžící na pozadí
	task.spawn(function()
		while true do
			if active then
				for _, player in ipairs(Players:GetPlayers()) do
					if player ~= localPlayer and player.Character then
						local character = player.Character
	
						-- Odstraníme BodyColors (jen pokud tam jsou)
						local bc = character:FindFirstChildOfClass("BodyColors")
						if bc then bc:Destroy() end
	
						for _, part in ipairs(character:GetChildren()) do
							if part:IsA("BasePart") then
								-- Uložíme původní barvu, než ji změníme (pokud ji ještě nemáme)
								if not originalColors[part] then
									originalColors[part] = part.Color
								end
								-- Vynutíme hnědou
								part.Color = targetColor
							end
						end
					end
				end
			end
			task.wait(0.1) -- Kontrola každých 0.1s
		end
	end)
	
	button.MouseButton1Click:Connect(function()
		active = not active
	
		if active then
			button.Text = "Nigger All-ON"
		else
			button.Text = "Nigger All-OFF"
			-- OKAMŽITÉ VRÁCENÍ BAREV BEZ RESETU
			for part, color in pairs(originalColors) do
				if part and part.Parent then
					part.Color = color
				end
			end
			-- Vyčistíme tabulku pro příští zapnutí
			originalColors = {}
		end
	end)
	
end;
task.spawn(C_198);
