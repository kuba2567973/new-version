local function C_106()
local script = G2L["106"];
	local Players = game:GetService("Players")
	local lp = Players.LocalPlayer
	local btn = script.Parent
	-- Make sure this path to your textbox is 100% correct!
	local txtbox = script.Parent.Parent.pos
	
	btn.Activated:Connect(function()
		local char = lp.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
	
		if hrp then
			-- 1. Split the text by commas
			local coords = {}
			for word in string.gmatch(txtbox.Text, "[^,]+") do
				table.insert(coords, tonumber(word))
			end
	
			-- 2. Check if we actually got 3 numbers
			if #coords == 3 then
				local targetPos = Vector3.new(coords[1], coords[2], coords[3])
				hrp.CFrame = CFrame.new(targetPos)
			end
		end
	end)
	
	txtbox.Changed:Connect(function()
		btn.Text = "TP to " .. txtbox.Text
	end)
end;
