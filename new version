				local direction = Vector3.new(0, 0, 0)
				if UIS:IsKeyDown(Enum.KeyCode.W) then direction += camera.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.S) then direction -= camera.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.A) then direction -= camera.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.D) then direction += camera.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.new(0, 1, 0) end
				if UIS:IsKeyDown(Enum.KeyCode.Q) then direction -= Vector3.new(0, 1, 0) end
	
				root.RotVelocity = Vector3.new(0, 0, 0)
				bodyVelocity.Velocity = direction.Magnitude > 0 and (direction.Unit * currentSpeed) or Vector3.new(0,0,0)
	
				root.CFrame = CFrame.new(root.Position, root.Position + camera.CFrame.LookVector)
			end)
	
		else
			-- STOP FLYING
			RunService:UnbindFromRenderStep("FlyLoop")
	
			if bodyVelocity then
				bodyVelocity:Destroy()
				bodyVelocity = nil
			end
	
			if hum.SeatPart then
				hum.PlatformStand = false
				hum:ChangeState(Enum.HumanoidStateType.Seated) 
			else
				setAnims(true)
				hum.PlatformStand = false
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
				task.wait(0.05)
				hum:ChangeState(Enum.HumanoidStateType.Running)
	
				hum.Jump = true
				task.wait(0.03)
				hum.Jump = false
			end
		end
	end
	
	-----------------------------------
	-- BUTTONS
	-----------------------------------
	local function setFlySpeedFromButton(btn)
		if btn.Text and tonumber(btn.Text) then
			speedInput.Text = btn.Text
		else
			speedInput.Text = "60"
		end
	end
	
	btn1.MouseButton1Click:Connect(function() setFlySpeedFromButton(btn1) end)
	btn2.MouseButton1Click:Connect(function() setFlySpeedFromButton(btn2) end)
	btn3.MouseButton1Click:Connect(function() setFlySpeedFromButton(btn3) end)
	btn4.MouseButton1Click:Connect(function() setFlySpeedFromButton(btn4) end)
	btn6.MouseButton1Click:Connect(function() setFlySpeedFromButton(btn6) end)
	btn7.MouseButton1Click:Connect(function() setFlySpeedFromButton(btn7) end)
	
	btn5.MouseButton1Click:Connect(function()
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			speedInput.Text = tostring(math.floor(hum.WalkSpeed))
		else
			speedInput.Text = "16"
		end
	end)
	
	flyButton.MouseButton1Click:Connect(function()
		flying = not flying
		flyButton.Text = flying and "Fly-ON" or "Fly-OFF"
		toggleFlyMode(flying)
	end)
	
	UIS.InputBegan:Connect(function(i, g)
		if not g and i.KeyCode == Enum.KeyCode.LeftAlt and flying then
			flyActive = not flyActive
			toggleFlyMode(flyActive)
		end
	end)
	
	-----------------------------------
	-- RESPAWN LOGIC
	-----------------------------------
	player.CharacterAdded:Connect(function()
		flyActive = false 
		RunService:UnbindFromRenderStep("FlyLoop")
	
		if bodyVelocity then
			bodyVelocity:Destroy()
			bodyVelocity = nil
		end
	end)
