local function C_1ce()
local script = G2L["1ce"];
	-- PREVENT DOUBLE RUN
	if _G.AIMBOT_RUNNING then return end
	_G.AIMBOT_RUNNING = true
	
	-- SERVICES
	local UIS = game:GetService("UserInputService")
	local RS = game:GetService("RunService")
	local Players = game:GetService("Players")
	
	local lp = Players.LocalPlayer
	local cam = workspace.CurrentCamera
	
	-- Attempt to get SettingsManager
	local SettingsManager = require(lp.PlayerGui:WaitForChild("HHHHAAAACCCCKKKK"):WaitForChild("SettingsManager"))
	
	local menu = script.Parent.Parent
	local aimBtn = menu:WaitForChild("ambo")
	local teamBtn = menu:WaitForChild("tmchk")
	local wallBtn = menu:WaitForChild("wchk")
	local radiustxtbox = menu:WaitForChild("fvr")
	local shwfvrad = menu:WaitForChild("shfv")
	local rnbwBtn = script.Parent.Parent.Parent.Rg:FindFirstChild("rawispn")
	
	-- INITIAL SETTINGS
	local aim_On = SettingsManager.get("aimbot", false)
	local aim_TC = SettingsManager.get("aimbotTeamCheck", true)
	local aim_WC = SettingsManager.get("aimbotWallCheck", true)
	local showFOV = SettingsManager.get("aimbotShowFOV", false)
	local rainbow = SettingsManager.get("aimbotRGB", false)
	local FOV_RADIUS = SettingsManager.get("aimbotFOVRadius", 400)
	
	local aiming = false
	local TARGET_PART = "Head"
	local lockedTarget = nil
	local hue = 0
	
	---------------------------------------------------
	-- UI SYNC (Independent)
	---------------------------------------------------
	local function updateAimBtn()
		aimBtn.Text = "Aimbot-" .. (aim_On and "ON" or "OFF")
	end
	
	local function updateTeamBtn()
		teamBtn.Text = "TeamCheck-" .. (aim_TC and "ON" or "OFF")
	end
	
	local function updateWallBtn()
		wallBtn.Text = "WallCheck-" .. (aim_WC and "ON" or "OFF")
	end
	
	local function updateFovUI()
		shwfvrad.Text = "ShowFOV-" .. (showFOV and "ON" or "OFF")
		radiustxtbox.Text = tostring(FOV_RADIUS)
	end
	
	local function updateRnbwBtn()
		rnbwBtn.Text = "RGB-" .. (rainbow and "ON" or "OFF")
	end
	
	-- Init UI
	updateAimBtn()
	updateTeamBtn()
	updateWallBtn()
	updateFovUI()
	updateRnbwBtn()
	
	---------------------------------------------------
	-- FOV CIRCLE SETUP
	---------------------------------------------------
	local screenGui = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
	screenGui.Name = "FOVCircle"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	
	local fovCircle = Instance.new("Frame", screenGui)
	fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
	fovCircle.BackgroundTransparency = 1
	fovCircle.Visible = showFOV -- Always respects setting, ignores aim_On status
	
	local corner = Instance.new("UICorner", fovCircle)
	corner.CornerRadius = UDim.new(1, 0)
	
	local stroke = Instance.new("UIStroke", fovCircle)
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(255, 0, 0)
	
	local function updateVisuals()
		-- Sync circle size and visibility to showFOV setting only
		local viewport = cam.ViewportSize
		fovCircle.Visible = showFOV 
		fovCircle.Position = UDim2.fromOffset(viewport.X / 2, viewport.Y / 2)
		fovCircle.Size = UDim2.fromOffset(FOV_RADIUS * 2, FOV_RADIUS * 2)
	
		-- RGB Check: Checks local rainbow setting OR the global ESP rainbow setting
		local globalESPRainbow = SettingsManager.get("espRGB", false) 
	
		if rainbow or globalESPRainbow then
			hue = (tick() % 5) / 5
			stroke.Color = Color3.fromHSV(hue, 1, 1)
		else
			stroke.Color = Color3.fromRGB(255, 0, 0)
		end
	end
	
	---------------------------------------------------
	-- CORE FUNCTIONS
	---------------------------------------------------
	local function canSee(char, part)
		if not aim_WC then return true end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {lp.Character, cam}
		local result = workspace:Raycast(cam.CFrame.Position, (part.Position - cam.CFrame.Position), params)
		return result == nil or result.Instance:IsDescendantOf(char)
	end
	
	local function getTarget()
		if not aim_On then return nil end
		local closestDist = FOV_RADIUS
		local closestPart = nil
		local center = cam.ViewportSize / 2
	
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr == lp or (aim_TC and plr.Team == lp.Team) then continue end
			local char = plr.Character
			local part = char and char:FindFirstChild(TARGET_PART)
			local hum = char and char:FindFirstChildOfClass("Humanoid")
	
			if part and hum and hum.Health > 0 then
				local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
				if onScreen then
					local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
					if dist < closestDist and canSee(char, part) then
						closestDist = dist
						closestPart = part
					end
				end
			end
		end
		return closestPart
	end
	
	---------------------------------------------------
	-- CONNECTIONS
	---------------------------------------------------
	aimBtn.MouseButton1Click:Connect(function()
		aim_On = not aim_On
		SettingsManager.set("aimbot", aim_On)
		updateAimBtn()
	end)
	
	teamBtn.MouseButton1Click:Connect(function()
		aim_TC = not aim_TC
		SettingsManager.set("aimbotTeamCheck", aim_TC)
		updateTeamBtn()
	end)
	
	wallBtn.MouseButton1Click:Connect(function()
		aim_WC = not aim_WC
		SettingsManager.set("aimbotWallCheck", aim_WC)
		updateWallBtn()
	end)
	
	shwfvrad.MouseButton1Click:Connect(function()
		showFOV = not showFOV
		SettingsManager.set("aimbotShowFOV", showFOV)
		updateFovUI()
	end)
	
	rnbwBtn.MouseButton1Click:Connect(function()
		rainbow = not rainbow
		SettingsManager.set("aimbotRGB", rainbow)
		updateRnbwBtn()
	end)
	
	radiustxtbox.FocusLost:Connect(function()
		local num = tonumber(radiustxtbox.Text)
		if num then
			FOV_RADIUS = math.clamp(num, 1, 5000)
			SettingsManager.set("aimbotFOVRadius", FOV_RADIUS)
			updateFovUI()
		end
	end)
	
	UIS.InputBegan:Connect(function(i, g) if not g and i.UserInputType == Enum.UserInputType.MouseButton2 then aiming = true end end)
	UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton2 then aiming = false lockedTarget = nil end end)
	
	---------------------------------------------------
	-- MAIN LOOP
	---------------------------------------------------
	RS.RenderStepped:Connect(function()
		updateVisuals()
	
		if not aim_On or not aiming then
			lockedTarget = nil
			return
		end
	
		if lockedTarget then
			local char = lockedTarget.Parent
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local plr = Players:GetPlayerFromCharacter(char)
			if not hum or hum.Health <= 0 or (aim_TC and plr.Team == lp.Team) or not canSee(char, lockedTarget) then
				lockedTarget = nil
			end
		end
	
		if not lockedTarget then
			lockedTarget = getTarget()
		end
	
		if lockedTarget then
			cam.CFrame = CFrame.new(cam.CFrame.Position, lockedTarget.Position)
		end
	end)
end;
