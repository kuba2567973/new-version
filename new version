local function C_227()
local script = G2L["227"];
	local button = script.Parent
	local Lighting = game:GetService("Lighting")
	local Players = game:GetService("Players")
	local Terrain = workspace:FindFirstChildOfClass("Terrain")
	
	local enabled = false
	local loopRunning = false
	
	-- Store originals
	local originalLighting = {
		GlobalShadows = Lighting.GlobalShadows,
		Brightness = Lighting.Brightness,
		EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
		EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
	}
	
	local originalParts = {}
	local originalTextures = {}
	local originalEffects = {}
	local originalParticles = {}
	local originalMeshes = {}
	local hiddenCharacters = {}
	
	-- Sky
	local originalSky = Lighting:FindFirstChildOfClass("Sky")
	
	local darkSky = Instance.new("Sky")
	darkSky.SkyboxBk = "rbxassetid://2350402582"
	darkSky.SkyboxDn = "rbxassetid://2350402582"
	darkSky.SkyboxFt = "rbxassetid://2350402582"
	darkSky.SkyboxLf = "rbxassetid://2350402582"
	darkSky.SkyboxRt = "rbxassetid://2350402582"
	darkSky.SkyboxUp = "rbxassetid://2350402582"
	darkSky.SunTextureId = ""
	darkSky.MoonTextureId = ""
	
	-- Terrain safe
	local originalTerrainDecoration
	if Terrain then
		pcall(function()
			originalTerrainDecoration = Terrain.Decoration
		end)
	end
	
	-- CLEAN DEBRIS (ragdolls, loose parts)
	local Players = game:GetService("Players")
	local Debris = game:GetService("Debris")
	
	local function cleanDebris()
		-- Optimalizace: Procházíme jen přímé potomky složky (pokud ji máš) 
		-- nebo workspace, ale s pauzami.
		local objects = workspace:GetChildren() -- GetChildren je rychlejší než GetDescendants
	
		for i, model in pairs(objects) do
			-- Kontrola každých 20 objektů, aby se ulevilo CPU
			if i % 20 == 0 then task.wait() end
	
			if model:IsA("Model") then
				local humanoid = model:FindFirstChildOfClass("Humanoid")
	
				-- Pokud je to mrtvé NPC (není to hráč)
				if humanoid and humanoid.Health <= 0 then
					if not Players:GetPlayerFromCharacter(model) then
						-- Debris zajistí smazání bez okamžitého záseku
						Debris:AddItem(model, 0.1)
					end
				end
			elseif model:IsA("BasePart") and not model.Anchored then
				-- Smaže volné části, které nejsou ukotvené
				Debris:AddItem(model, 0.1)
			end
		end
	end
	
	
	-- HIDE OTHER PLAYERS (huge FPS boost)
	local function hidePlayers()
		for _, player in pairs(Players:GetPlayers()) do
			if player ~= Players.LocalPlayer then
				local char = player.Character
				if char and not hiddenCharacters[char] then
					hiddenCharacters[char] = true
					char.Parent = nil
				end
			end
		end
	end
	
	local function restorePlayers()
		for char, _ in pairs(hiddenCharacters) do
			if char then
				char.Parent = workspace
			end
		end
		hiddenCharacters = {}
	end
	
	-- APPLY
	local function applyUltra()
		Lighting.GlobalShadows = false
		Lighting.Brightness = 1
		Lighting.EnvironmentDiffuseScale = 0
		Lighting.EnvironmentSpecularScale = 0
	
		-- Effects
		for _, v in pairs(Lighting:GetChildren()) do
			if v:IsA("PostEffect") then
				if originalEffects[v] == nil then
					originalEffects[v] = v.Enabled
				end
				v.Enabled = false
			end
		end
	
		-- Sky
		if originalSky and originalSky.Parent then
			originalSky.Parent = nil
		end
		if not darkSky.Parent then
			darkSky.Parent = Lighting
		end
	
		-- Terrain
		if Terrain then
			pcall(function()
				Terrain.Decoration = false
				Terrain.WaterWaveSize = 0
				Terrain.WaterWaveSpeed = 0
				Terrain.WaterReflectance = 0
				Terrain.WaterTransparency = 1
			end)
		end
	
		for _, obj in pairs(workspace:GetDescendants()) do
	
			if obj:IsA("BasePart") then
				if originalParts[obj] == nil then
					originalParts[obj] = {
						Material = obj.Material,
						CastShadow = obj.CastShadow,
						Reflectance = obj.Reflectance,
					}
				end
	
				obj.Material = Enum.Material.SmoothPlastic
				obj.CastShadow = false
				obj.Reflectance = 0
			end
	
			if obj:IsA("Texture") or obj:IsA("Decal") then
				if originalTextures[obj] == nil then
					originalTextures[obj] = obj.Transparency
				end
				obj.Transparency = 1
			end
	
			if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
				if originalParticles[obj] == nil then
					originalParticles[obj] = obj.Enabled
				end
				obj.Enabled = false
			end
	
			if obj:IsA("MeshPart") then
				if originalMeshes[obj] == nil then
					originalMeshes[obj] = obj.TextureID
				end
				obj.TextureID = ""
			elseif obj:IsA("SpecialMesh") then
				if originalMeshes[obj] == nil then
					originalMeshes[obj] = obj.TextureId
				end
				obj.TextureId = ""
			end
		end
	
		-- Extra FPS
		cleanDebris()
		hidePlayers()
	end
	
	local RENDER_DISTANCE = 250 -- tweak: 150 = very low, 250 = medium, 400 = high
	
	local function updateRenderDistance()
		local camera = workspace.CurrentCamera
		if not camera then return end
	
		local camPos = camera.CFrame.Position
	
		for _, obj in pairs(workspace:GetDescendants()) do
			if obj:IsA("BasePart") then
				local dist = (obj.Position - camPos).Magnitude
	
				if dist > RENDER_DISTANCE then
					obj.LocalTransparencyModifier = 1
					obj.CastShadow = false
				else
					obj.LocalTransparencyModifier = 0
				end
			end
		end
	end
	
	local function removeAccessories()
		for _, player in pairs(game:GetService("Players"):GetPlayers()) do
			local char = player.Character
			if char then
				for _, obj in pairs(char:GetChildren()) do
					if obj:IsA("Accessory") then
						obj:Destroy()
					end
				end
			end
		end
	end
	
	-- RESTORE
	local function restoreAll()
		for k, v in pairs(originalLighting) do
			Lighting[k] = v
		end
	
		if darkSky.Parent then
			darkSky.Parent = nil
		end
		if originalSky then
			originalSky.Parent = Lighting
		end
	
		for obj, state in pairs(originalEffects) do
			if obj and obj.Parent then
				obj.Enabled = state
			end
		end
	
		if Terrain then
			pcall(function()
				if originalTerrainDecoration ~= nil then
					Terrain.Decoration = originalTerrainDecoration
				end
			end)
		end
	
		for part, data in pairs(originalParts) do
			if part and part.Parent then
				part.Material = data.Material
				part.CastShadow = data.CastShadow
				part.Reflectance = data.Reflectance
			end
		end
	
		for tex, state in pairs(originalTextures) do
			if tex and tex.Parent then
				tex.Transparency = state
			end
		end
	
		for obj, state in pairs(originalParticles) do
			if obj and obj.Parent then
				obj.Enabled = state
			end
		end
	
		for mesh, tex in pairs(originalMeshes) do
			if mesh and mesh.Parent then
				if mesh:IsA("MeshPart") then
					mesh.TextureID = tex
				elseif mesh:IsA("SpecialMesh") then
					mesh.TextureId = tex
				end
			end
		end
	
		restorePlayers()
	end
	
	-- LOOP
	local function startLoop()
		if loopRunning then return end
		loopRunning = true
	
		task.spawn(function()
			while enabled do
				applyUltra()
				cleanDebris()
				updateRenderDistance()
				removeAccessories()
				task.wait(3)
			end
			loopRunning = false
		end)
	end
	
	-- BUTTON
	button.MouseButton1Click:Connect(function()
		enabled = not enabled
		button.Text = "Potato mode🤑🤑-ON"
		if enabled then
			applyUltra()
			startLoop()
		else
			restoreAll()
			button.Text = "Normal mode🥀✌️-OFF"
		end
	end)
end;
