					obj.distLabel.Size = UDim2.fromOffset(180 * finalScale, 20 * finalScale)
					obj.distLabel.Position = UDim2.fromOffset(screenPos.X, screenPos.Y + (height/2) + 8 * finalScale)
					obj.distLabel.Text = dist .. " studs"
					obj.distLabel.TextColor3 = activeColor
					obj.distLabel.Visible = true
	
					-- Health Bar
					obj.healthFrame.Position = UDim2.fromOffset(screenPos.X + (width/2) + 6, screenPos.Y - (height/2) - 2)
					obj.healthFrame.Size = UDim2.fromOffset(3, height + 4)
					obj.healthFrame.Visible = true
					obj.healthBar.Size = UDim2.new(1, 0, humanoid.Health / humanoid.MaxHealth, 0)
