local function C_12a()
local script = G2L["12a"];
	local spd = script.Parent
	local camera = workspace.CurrentCamera
	local player = game.Players.LocalPlayer
	
	local textBox = script.Parent
	local buttons = {
		script.Parent.Parent:WaitForChild("fv40"),
		script.Parent.Parent:WaitForChild("fv80"),
		script.Parent.Parent:WaitForChild("fv100"),
		script.Parent.Parent:WaitForChild("fv1K"),
		script.Parent.Parent:WaitForChild("fv150"),
		script.Parent.Parent:WaitForChild("fv200")
	}
	
	
	
	local currentFOV = 120
	
	local fovConnection = nil
	
	
	
	-- Function that applies the high FOV every frame
	
	local function applyFOV(fovValue)
	
		currentFOV = math.clamp(tonumber(fovValue) or 120, 1, 2000)  -- safety clamp
	
	
	
		if fovConnection then fovConnection:Disconnect() end
	
	
	
		fovConnection = game:GetService("RunService").RenderStepped:Connect(function()
	
			-- First set normal FOV (helps base)
	
			camera.FieldOfView = math.min(currentFOV, 300)
	
	
	
			-- Distortion to push beyond 120
	
			if currentFOV > 120 then
	
				local factor = (currentFOV - 120) * 0.008   -- tweak this multiplier if needed (0.006 ~ 0.012 range is common)
	
				camera.CoordinateFrame = camera.CoordinateFrame * CFrame.new(0, 0, 0,
					1 - factor, 0, 0,
					0, 1 - factor, 0,
					0, 0, 1
	
				)
			end
		end)
	end
	
	
	
	-- Quick buttons: when clicked, set TextBox and apply FOV
	
	for _, btn in ipairs(buttons) do
		btn.MouseButton1Click:Connect(function()
			local btnText = btn.Text
			-- Extract the number (removes "fv" prefix)
			local numStr = btnText:match("%d+")
			if numStr then
				textBox.Text = numStr
				applyFOV(numStr)
			end
		end)
	end
	
	
	
	-- TextBox: update when user types and presses Enter or loses focus
	
	textBox.FocusLost:Connect(function(enterPressed)
		if enterPressed or textBox.Text ~= "" then
			applyFOV(textBox.Text)
		end
	end)
	
	
	
	-- Optional: Auto-apply when text changes (more responsive)
	
	textBox:GetPropertyChangedSignal("Text"):Connect(function()
		local num = tonumber(textBox.Text)
		if num then
			applyFOV(num)
		end
	end)
	
	textBox.Text = tostring(currentFOV)
	applyFOV(currentFOV)
end;
