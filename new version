-- StarterGui.HHHHAAAACCCCKKKK.GUI.txbas.Pl.JumpPowweeer.LocalScript
local function C_af()
local script = G2L["af"];
	local player = game.Players.LocalPlayer
	
	local textBox = script.Parent
	
	local buttons = {
		unjmp    = script.Parent.Parent:WaitForChild("unjmp"),
		highjmp  = script.Parent.Parent:WaitForChild("highjmp"),
		megajmp  = script.Parent.Parent:WaitForChild("megajmp"),
		ultrajmp = script.Parent.Parent:WaitForChild("ultrajmp")
	}
	
	local currentValue = 50
	local jumpConnection = nil
	local isUsingJumpHeight = false
	
	-- Apply jump every frame
	local function applyJump(value)
		currentValue = tonumber(value) or (isUsingJumpHeight and 7.159 or 50)
	
		if jumpConnection then jumpConnection:Disconnect() end
	
		jumpConnection = game:GetService("RunService").RenderStepped:Connect(function()
			local character = player.Character
			if not character then return end
			local humanoid = character:FindFirstChild("Humanoid")
			if not humanoid then return end
	
			if isUsingJumpHeight then
				humanoid.JumpHeight = currentValue
			else
				humanoid.JumpPower = currentValue
			end
		end)
	end
	
	-- Update button texts based on detected system
	local function updateButtonTexts()
		if isUsingJumpHeight then
			buttons.unjmp.Text    = "7.159"
			buttons.highjmp.Text  = "40"
			buttons.megajmp.Text  = "300"
			buttons.ultrajmp.Text = "100"
		else
			buttons.unjmp.Text    = "50"
			buttons.highjmp.Text  = "80"
			buttons.megajmp.Text  = "400"
			buttons.ultrajmp.Text = "150"
		end
	end
	
	-- Detect which jump system the game uses
	local function detectJumpSystem()
		local character = player.Character or player.CharacterAdded:Wait()
		local humanoid = character:WaitForChild("Humanoid", 5)
	
		if humanoid then
			-- Best detection method
			isUsingJumpHeight = humanoid.UseJumpPower == false
		end
	
		print("Jump system detected → " .. (isUsingJumpHeight and "JumpHeight" or "JumpPower"))
	
		-- Update buttons and textbox according to system
		updateButtonTexts()
	
		if isUsingJumpHeight then
			currentValue = 7.159
			textBox.Text = "7.159"
		else
			currentValue = 50
			textBox.Text = "50"
		end
	
		applyJump(currentValue)
	end
	
	-- Button functionality
	local function setupButton(btnName, powerValue, heightValue)
		local btn = buttons[btnName]
		if not btn then return end
	
		btn.MouseButton1Click:Connect(function()
			local newValue = isUsingJumpHeight and heightValue or powerValue
			textBox.Text = tostring(newValue)
			applyJump(newValue)
		end)
	end
	
	setupButton("unjmp",    50,     7.159)
	setupButton("highjmp",  80,     40)
	setupButton("megajmp",  400,    300)
	setupButton("ultrajmp", 150,    100)
	
	-- TextBox live updating
	textBox.FocusLost:Connect(function()
		if textBox.Text ~= "" then
			applyJump(textBox.Text)
		end
	end)
	
	textBox:GetPropertyChangedSignal("Text"):Connect(function()
		local num = tonumber(textBox.Text)
		if num then
			applyJump(num)
		end
	end)
	
	-- Handle respawn
	player.CharacterAdded:Connect(function()
		task.wait(0.8)
		detectJumpSystem()
	end)
	
	-- Initial setup
	task.wait(1)
	detectJumpSystem()
	
	print("Universal Jump Changer v2 loaded - Buttons now change text automatically")
end;
