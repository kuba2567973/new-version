local function C_124()
local script = G2L["124"];
	local RunService = game:GetService("RunService")
	local workspace = game:GetService("Workspace")
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local camera = workspace.CurrentCamera
	
	local SettingsManager = require(LocalPlayer.PlayerGui:WaitForChild("HHHHAAAACCCCKKKK"):WaitForChild("SettingsManager"))
	
	local textBox = script.Parent
	local fldr = script.Parent.Parent
	local deF = fldr:WaitForChild("deF") -- The toggle button
	
	local buttons = {
		fldr:WaitForChild("dfF"),
		fldr:WaitForChild("80F"),
		fldr:WaitForChild("100F"),
		fldr:WaitForChild("120F"),
		fldr:WaitForChild("150F"),
		fldr:WaitForChild("200F")
	}
	
	-- Load saved FOV or default to 120
	local currentFOV = SettingsManager.get("fovValue", 120)
	local loopEnabled = SettingsManager.get("fovLoopEnabled", true) -- Load saved toggle state
	local fovConnection = nil
	
	-- Register with SettingsManager
	SettingsManager.register("fovValue", function() return currentFOV end)
	SettingsManager.register("fovLoopEnabled", function() return loopEnabled end)
	
	local function updateToggleText()
		deF.Text = loopEnabled and "Updating-ON" or "Updating-OFF"
	end
	
	-- Function that applies the high FOV every frame
	local function applyFOV(fovValue)
		local num = tonumber(fovValue)
		if num then
			currentFOV = math.clamp(num, 1, 2000)
			textBox.Text = tostring(currentFOV)
		end
	
		if fovConnection then fovConnection:Disconnect() end
	
		fovConnection = RunService.RenderStepped:Connect(function()
			-- THE TOGGLE CHECK
			if not loopEnabled then return end
	
			-- Set base FOV
			camera.FieldOfView = math.min(currentFOV, 120)
	
			-- Distortion logic for "Super FOV"
			if currentFOV > 120 then
				local factor = (currentFOV - 120) * 0.008
				camera.CFrame = camera.CFrame * CFrame.new(0, 0, 0,
					1 - factor, 0, 0,
					0, 1 - factor, 0,
					0, 0, 1
				)
			end
		end)
	end
	
	-- Button Logic
	for _, btn in ipairs(buttons) do
		btn.MouseButton1Click:Connect(function()
			local numStr = btn.Text:match("%d+")
			if numStr then
				applyFOV(numStr)
			end
		end)
	end
	
	-- deF Toggle Logic
	deF.MouseButton1Click:Connect(function()
		loopEnabled = not loopEnabled
		updateToggleText()
	end)
	
	-- TextBox Logic
	textBox.FocusLost:Connect(function()
		if textBox.Text ~= "" then
			applyFOV(textBox.Text)
		end
	end)
	
	textBox:GetPropertyChangedSignal("Text"):Connect(function()
		local num = tonumber(textBox.Text)
		if num then
			applyFOV(num)
		end
	end)
	
	-- Initial Setup
	updateToggleText()
	applyFOV(currentFOV)
end;
