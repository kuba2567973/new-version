-- StarterGui.HHHHAAAACCCCKKKK.GUI.txbas.AmEs.ambo.LocalScript
local function C_19c()
local script = G2L["19c"];
	-- SERVICES
	local UIS = game:GetService("UserInputService")
	local RS = game:GetService("RunService")
	local Players = game:GetService("Players")
	
	-- PLAYER / CAMERA
	local lp = Players.LocalPlayer
	local cam = workspace.CurrentCamera
	
	-- UI
	local menu = script.Parent.Parent
	local aimBtn = menu:WaitForChild("ambo")
	local teamBtn = menu:WaitForChild("tmchk")
	local wallBtn = menu:WaitForChild("wchk")
	local radiustxtbox = menu:WaitForChild("fvr")
	local shwfvrad = menu:WaitForChild("shfv")
	local rnbwBtn = menu:WaitForChild("rnbw")
	
	-- STATES
	local aim_On = false
	local aim_TC = true
	local aim_WC = true
	local aiming = false
	local showFOV = false 
	local rainbow = false 
	
	-- SETTINGS
	local FOV_RADIUS = 400
	local TARGET_PART = "Head"
	
	-- INTERNAL
	local lockedTarget = nil
	local hue = 0
	
	---------------------------------------------------
	-- FOV CIRCLE
	---------------------------------------------------
	
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "FOVCircle"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.Parent = lp:WaitForChild("PlayerGui")
	
	local fovCircle = Instance.new("Frame")
	fovCircle.Parent = screenGui
	fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
	fovCircle.BackgroundTransparency = 1
	fovCircle.Visible = false
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = fovCircle
	
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(255, 0, 0)
	stroke.Parent = fovCircle
	
	local function updateFOVCircle()
		local viewport = cam.ViewportSize
		local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
	
		fovCircle.Position = UDim2.fromOffset(center.X, center.Y)
		fovCircle.Size = UDim2.fromOffset(FOV_RADIUS * 2, FOV_RADIUS * 2)
		fovCircle.Visible = showFOV
	
		if rainbow then
			hue = tick() % 5 / 5
			stroke.Color = Color3.fromHSV(hue, 1, 1)
		else
			stroke.Color = Color3.fromRGB(255, 0, 0)
		end
	end
	
	---------------------------------------------------
	-- BUTTONS & TEXTBOX
	---------------------------------------------------
	
	radiustxtbox.FocusLost:Connect(function()
		local num = tonumber(radiustxtbox.Text)
		if num then
			FOV_RADIUS = math.clamp(num, 0.1, 9999)
		end
	end)
	
	task.spawn(function()
		task.wait(0.3)
		local num = tonumber(radiustxtbox.Text)
		if num then
			FOV_RADIUS = math.clamp(num, 10, 2000)
		end
	end)
	
	aimBtn.MouseButton1Click:Connect(function()
		aim_On = not aim_On
		aimBtn.Text = "Aimbot-" .. (aim_On and "ON" or "OFF")
	end)
	
	teamBtn.MouseButton1Click:Connect(function()
		aim_TC = not aim_TC
		teamBtn.Text = "TeamCheck-" .. (aim_TC and "ON" or "OFF")
	end)
	
	wallBtn.MouseButton1Click:Connect(function()
		aim_WC = not aim_WC
		wallBtn.Text = "WallCheck-" .. (aim_WC and "ON" or "OFF")
	end)
	
	shwfvrad.MouseButton1Click:Connect(function()
		showFOV = not showFOV
		shwfvrad.Text = "ShowFOV-" .. (showFOV and "ON" or "OFF")
	end)
	
	rnbwBtn.MouseButton1Click:Connect(function()
		rainbow = not rainbow
		rnbwBtn.Text = "RGB-" .. (rainbow and "ON" or "OFF")
	end)
	
	-----------------------------------
	-- INPUT
	-----------------------------------
	UIS.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			aiming = true
			lockedTarget = nil
		end
	end)
	
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			aiming = false
			lockedTarget = nil
		end
	end)
	
	-----------------------------------
	-- CHECKS & VALIDATION
	-----------------------------------
	local function hasForceField(char)
		return char and char:FindFirstChildOfClass("ForceField") ~= nil
	end
	
	local function wallCheck(char, part)
		if not aim_WC then return true end
		local origin = cam.CFrame.Position
		local direction = part.Position - origin
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { lp.Character or {}, cam }
		local result = workspace:Raycast(origin, direction, params)
		if not result then return true end
		return result.Instance:IsDescendantOf(char)
	end
	
	-- NEW: Function to check if our current target is still valid
	local function isTargetValid(part)
		if not part or not part.Parent then return false end
	
		local char = part.Parent
		local hum = char:FindFirstChildOfClass("Humanoid")
		local plr = Players:GetPlayerFromCharacter(char)
	
		-- Check if they are dead, missing a humanoid, or have a forcefield
		if not hum or hum.Health <= 0 or hasForceField(char) then
			return false
		end
	
		-- Check if they switched to your team while you were aiming
		if aim_TC and plr and plr.Team == lp.Team then
			return false
		end
	
		return true
	end
	
	-----------------------------------
	-- GET TARGET (CENTER BASED)
	-----------------------------------
	local function getTarget()
		local closestDist = FOV_RADIUS
		local closestPart = nil
	
		local viewport = cam.ViewportSize
		local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
	
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr == lp then continue end
			if aim_TC and plr.Team == lp.Team then continue end
	
			local char = plr.Character
			if not char or hasForceField(char) then continue end
	
			local hum = char:FindFirstChildOfClass("Humanoid")
			local part = char:FindFirstChild(TARGET_PART)
			if not hum or hum.Health <= 0 or not part then continue end
	
			local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
			if not onScreen then continue end
	
			local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
	
			if dist < closestDist and wallCheck(char, part) then
				closestDist = dist
				closestPart = part
			end
		end
		return closestPart
	end
	
	-----------------------------------
	-- MAIN LOOP
	-----------------------------------
	RS.RenderStepped:Connect(function()
		updateFOVCircle()
	
		if not aim_On or not aiming then
			lockedTarget = nil
			return
		end
	
		-- If we have a target, check if they are still alive/valid
		if lockedTarget then
			if not isTargetValid(lockedTarget) then
				lockedTarget = nil -- Clear it so we can find someone new
			end
		end
	
		-- Find a target if we don't have one
		if not lockedTarget then
			lockedTarget = getTarget()
		end
	
		-- Lock camera to target
		if lockedTarget then
			local targetPos = lockedTarget.Position
			cam.CFrame = CFrame.new(cam.CFrame.Position, targetPos)
		end
	end)
end;
