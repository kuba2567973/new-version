	SettingsManager.register("aimbotRGB", function() return rainbow end)
	SettingsManager.register("aimbotFOVRadius", function() return FOV_RADIUS end)
	
	-- Update UI text to match loaded saves
	local function updateUI()
		aimBtn.Text = "Aimbot-" .. (aim_On and "ON" or "OFF")
		teamBtn.Text = "TeamCheck-" .. (aim_TC and "ON" or "OFF")
		wallBtn.Text = "WallCheck-" .. (aim_WC and "ON" or "OFF")
		shwfvrad.Text = "ShowFOV-" .. (showFOV and "ON" or "OFF")
		rnbwBtn.Text = "RGB-" .. (rainbow and "ON" or "OFF")
		radiustxtbox.Text = tostring(FOV_RADIUS)
	end
	updateUI()
	
	---------------------------------------------------
	-- FOV CIRCLE
	---------------------------------------------------
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "FOVCircle"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.Parent = lp:WaitForChild("PlayerGui")
	
