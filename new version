local function C_278()
local script = G2L["278"];
	local waitTime = 0.02
	local but = script.Parent
	local but2 = script.Parent.Parent.GUI.txbas.Gra:WaitForChild("vlfs")
	local lastUpdateTime = tick()
	
	local deltaTimesInterval = {}
	
	local numDP = 1
	
	local vis = true
	
	game:GetService("RunService").RenderStepped:Connect(function(deltaTime)
		
		local now = tick()
		local timePassed = now - lastUpdateTime
		
		table.insert(deltaTimesInterval, deltaTime)
	
		if timePassed >= waitTime then
			
			local totalDeltaTime = 0		
			for _, deltaTimeRecorded in pairs(deltaTimesInterval) do
				totalDeltaTime += deltaTimeRecorded
			end
			
			local numDeltas = #deltaTimesInterval
			
			local avgDeltaTime = totalDeltaTime / numDeltas
			
			local framesPerSecond = 1 / avgDeltaTime
			local formattedFPS = math.round(framesPerSecond)
			
			table.clear(deltaTimesInterval)
			
	
			but.Text = "fps " .. formattedFPS
	
			lastUpdateTime = now
			if formattedFPS < 30 then
				but.TextColor3 = Color3.new(1, 0, 0)
			elseif formattedFPS < 60 then
				but.TextColor3 = Color3.new(1, 0.6, 0)
			elseif formattedFPS > 60 then
				but.TextColor3 = Color3.new(0, 1, 0)
			end	
		end
	end)
	
	but2.Activated:Connect(function()
		vis = not vis
		if vis == false then
			but2.Text = "Debug fps-OFF"
			but.Visible = false
		else
			but2.Text = "Debug fps-ON"
			but.Visible = true
		end
	end)
end;
