	player.CharacterAdded:Connect(function(char)
		local root = char:WaitForChild("HumanoidRootPart", 5)
		if root then
			lastPos = root.Position
		end
	end)
	
	-- Main loop that runs every 0.1 seconds
	while true do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
	
		if root then
			local currentPos = root.Position
	
			-- Distance / Time = Speed
			-- We divide by 0.1 because that is how much time passed
			local distance = (currentPos - lastPos).Magnitude
			local speed = distance / 0.1
	
			-- WalkSpeed style display (Whole number)
			label.Text = "Sps - " .. math.round(speed)
	
			lastPos = currentPos
		else
			label.Text = "Sps - 0"
		end
	
		task.wait(0.1) -- The update delay you requested
	end
end;
