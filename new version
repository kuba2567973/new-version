local function C_b4()
local script = G2L["b4"];
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local player = Players.LocalPlayer
	
	-- Saving System Integration
	local SettingsManager = require(player.PlayerGui:WaitForChild("HHHHAAAACCCCKKKK"):WaitForChild("SettingsManager"))
	
	local textBox = script.Parent
	local fldr = script.Parent.Parent
	
	local buttons = {
		unjmp    = fldr:WaitForChild("dfJ"),
		highjmp  = fldr:WaitForChild("80J"),
		megajmp  = fldr:WaitForChild("150J"),
		ultrajmp = fldr:WaitForChild("400J"),
		deJ      = fldr:WaitForChild("deJ") -- The new toggle button
	}
	
	-- Load saved value or default to 50
	local currentValue = SettingsManager.get("jumpValue", 50)
	local jumpConnection = nil
	local isUsingJumpHeight = false
	local loopEnabled = true -- Toggle state
	
	-- Register the value with the SettingsManager
	SettingsManager.register("jumpValue", function() return currentValue end)
	
	local function updateToggleText()
		buttons.deJ.Text = loopEnabled and "Updating-ON" or "Updating-OFF"
	end
	
	-- Apply jump every frame
	local function applyJump(value)
		local num = tonumber(value)
		if num then
			currentValue = num
			textBox.Text = tostring(num)
		end
	
		if jumpConnection then jumpConnection:Disconnect() end
	
		jumpConnection = RunService.RenderStepped:Connect(function()
			-- THE TOGGLE CHECK
			if not loopEnabled then return end
	
			local character = player.Character
			if not character then return end
			local humanoid = character:FindFirstChild("Humanoid")
			if not humanoid then return end
	
			if isUsingJumpHeight then
				if humanoid.JumpHeight ~= currentValue then
					pcall(function() humanoid.JumpHeight = currentValue end)
				end
			else
				if humanoid.JumpPower ~= currentValue then
					pcall(function() humanoid.JumpPower = currentValue end)
				end
			end
		end)
	end
	
	local function updateButtonTexts()
		if isUsingJumpHeight then
			buttons.unjmp.Text    = "7.159"
			buttons.highjmp.Text  = "40"
			buttons.megajmp.Text  = "300"
			buttons.ultrajmp.Text = "100"
		else
			buttons.unjmp.Text    = "50"
			buttons.highjmp.Text  = "80"
			buttons.megajmp.Text  = "400"
			buttons.ultrajmp.Text = "150"
		end
	end
	
	local function detectJumpSystem()
		local character = player.Character or player.CharacterAdded:Wait()
		local humanoid = character:WaitForChild("Humanoid", 5)
	
		if humanoid then
			isUsingJumpHeight = humanoid.UseJumpPower == false
		end
	
		updateButtonTexts()
		updateToggleText()
	
		-- Use the current (possibly saved) value
		applyJump(currentValue)
	end
	
	-- Button functionality
	local function setupButton(btnName, powerValue, heightValue)
		local btn = buttons[btnName]
		if not btn then return end
	
		btn.MouseButton1Click:Connect(function()
			local newValue = isUsingJumpHeight and heightValue or powerValue
			applyJump(newValue)
		end)
	end
	
	setupButton("unjmp",    50,     7.159)
	setupButton("highjmp",  80,     40)
	setupButton("megajmp",  400,    300)
	setupButton("ultrajmp", 150,    100)
	
	-- deJ Toggle Logic
	buttons.deJ.MouseButton1Click:Connect(function()
		loopEnabled = not loopEnabled
		updateToggleText()
	end)
	
	-- TextBox live updating
	textBox.FocusLost:Connect(function()
		if textBox.Text ~= "" then
			applyJump(textBox.Text)
		end
	end)
	
	textBox:GetPropertyChangedSignal("Text"):Connect(function()
		local num = tonumber(textBox.Text)
		if num then
			applyJump(num) -- This ensures the new value is saved/updated live
		end
	end)
	
	-- Handle respawn
	player.CharacterAdded:Connect(function()
		task.wait(0.8)
		detectJumpSystem()
	end)
	
	-- Initial setup
	task.wait(1)
	detectJumpSystem()
end;
