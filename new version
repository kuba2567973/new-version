	local button = script.Parent
	local player = game.Players.LocalPlayer
	
	local isEmoting = false
	local originalIds = {} 
	
	local function setupCharacter(character)
		local humanoid = character:WaitForChild("Humanoid")
		local rootPart = character:WaitForChild("HumanoidRootPart")
	
		-- Načtení animace (R15)
		local animObject = script:WaitForChild("takethelR15")
		local animTrack = humanoid:LoadAnimation(animObject)
		animTrack.Priority = Enum.AnimationPriority.Action
	
		-- Nastavení zvuku (zachováno ID a parametry)
		local sound = Instance.new("Sound")
		sound.Name = "EmoteSound"
		sound.SoundId = "rbxassetid://130990339683290"
		sound.Parent = rootPart
		sound.Looped = true
		sound.RollOffMaxDistance = 150
		sound.Volume = 4
		sound.PlaybackSpeed = 0.7
	
		local connection
		connection = button.MouseButton1Click:Connect(function()
			if not character or not character.Parent then connection:Disconnect() return end
			local animateScript = character:FindFirstChild("Animate")
			local animNames = {"idle", "walk", "run", "swim", "jump", "fall"}
	
			if not isEmoting then
				animTrack:Play()
				animTrack:AdjustSpeed(1.676767)
				sound.TimePosition = 0
				sound:Play()
	
				if animateScript then
					for _, name in pairs(animNames) do
						local folder = animateScript:FindFirstChild(name)
						if folder then
							local animObj = folder:FindFirstChildOfClass("Animation")
							if animObj then
								originalIds[name] = animObj.AnimationId 
								animObj.AnimationId = animObject.AnimationId 
							end
						end
					end
				end
				isEmoting = true
			else
				animTrack:Stop()
				sound:Stop()
				if animateScript then
					for _, name in pairs(animNames) do
						local folder = animateScript:FindFirstChild(name)
						if folder then
							local animObj = folder:FindFirstChildOfClass("Animation")
							if animObj and originalIds[name] then
								animObj.AnimationId = originalIds[name] 
							end
						end
					end
				end
				isEmoting = false
			end
	
			for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
				if track ~= animTrack then track:Stop(0.1) end
			end
		end)
	end
	
	if player.Character then setupCharacter(player.Character) end
	player.CharacterAdded:Connect(setupCharacter)
	
end;
