local function C_ed()
local script = G2L["ed"];
	local player = game.Players.LocalPlayer
	local camera = workspace.CurrentCamera
	local button = script.Parent -- your TextButton
	
	local modes = {
		{name = "First Person",  mode = Enum.CameraMode.LockFirstPerson},
		{name = "Third Person",  mode = Enum.CameraMode.Classic}
	}
	
	local currentIndex = 1
	local forceThirdConnection = nil
	
	local function updateButtonText()
		button.Text = "Camera: " .. modes[currentIndex].name
	end
	
	local function forceThirdPerson()
		if forceThirdConnection then forceThirdConnection:Disconnect() end
	
		forceThirdConnection = game:GetService("RunService").RenderStepped:Connect(function()
			player.CameraMode = Enum.CameraMode.Classic
			player.CameraMinZoomDistance = 0.5
			player.CameraMaxZoomDistance = 128
			camera.CameraType = Enum.CameraType.Custom
		end)
	end
	
	local function stopForcingThirdPerson()
		if forceThirdConnection then
			forceThirdConnection:Disconnect()
			forceThirdConnection = nil
		end
	end
	
	local function cycleCamera()
		currentIndex = currentIndex % #modes + 1
		local m = modes[currentIndex]
	
		-- Stop any active forcing first
		stopForcingThirdPerson()
	
		if m.name == "Third Person" then
			-- Force third person every frame so games can't lock you back to first
			forceThirdPerson()
		else
			-- Normal first person
			player.CameraMode = Enum.CameraMode.LockFirstPerson
			player.CameraMinZoomDistance = 0.5
			player.CameraMaxZoomDistance = 0.5
			camera.CameraType = Enum.CameraType.Custom
		end
	
		updateButtonText()
	end
	
	-- Initial setup
	button.MouseButton1Click:Connect(cycleCamera)
	updateButtonText()
	
	-- Optional: Start in Third Person by default (uncomment if you want)
	-- cycleCamera()
end;
