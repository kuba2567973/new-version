	local loopRunning = false
	
	-- Store originals
	local originalLighting = {
		GlobalShadows = Lighting.GlobalShadows,
		Brightness = Lighting.Brightness,
		EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
		EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
	}
	
	local originalParts = {}
	local originalTextures = {}
	local originalEffects = {}
	local originalParticles = {}
	local originalMeshes = {}
	
	-- Sky storage
	local originalSky = Lighting:FindFirstChildOfClass("Sky")
	
	-- Create dark sky
	local darkSky = Instance.new("Sky")
	darkSky.SkyboxBk = "rbxassetid://2350402582"
	darkSky.SkyboxDn = "rbxassetid://2350402582"
	darkSky.SkyboxFt = "rbxassetid://2350402582"
	darkSky.SkyboxLf = "rbxassetid://2350402582"
	darkSky.SkyboxRt = "rbxassetid://2350402582"
	darkSky.SkyboxUp = "rbxassetid://2350402582"
	darkSky.MoonTextureId = ""
	darkSky.SunTextureId = ""
	
	-- Terrain safe store
	local originalTerrainDecoration
	if Terrain then
		pcall(function()
			originalTerrainDecoration = Terrain.Decoration
		end)
	end
	
	-- APPLY ULTRA POTATO
	local function applyUltra()
		-- Lighting
		Lighting.GlobalShadows = false
		Lighting.Brightness = 1
		Lighting.EnvironmentDiffuseScale = 0
		Lighting.EnvironmentSpecularScale = 0
	
		-- Disable post effects
		for _, v in pairs(Lighting:GetChildren()) do
			if v:IsA("PostEffect") then
				if originalEffects[v] == nil then
					originalEffects[v] = v.Enabled
				end
				v.Enabled = false
			end
		end
	
		-- Replace sky
		if originalSky and originalSky.Parent then
			originalSky.Parent = nil
		end
		if not darkSky.Parent then
			darkSky.Parent = Lighting
		end
	
		-- Terrain safe
		if Terrain then
			pcall(function()
				Terrain.Decoration = false
				Terrain.WaterWaveSize = 0
				Terrain.WaterWaveSpeed = 0
				Terrain.WaterReflectance = 0
				Terrain.WaterTransparency = 1
			end)
		end
	
		for _, obj in pairs(workspace:GetDescendants()) do
	
			if obj:IsA("BasePart") then
				if originalParts[obj] == nil then
					originalParts[obj] = {
						Material = obj.Material,
						CastShadow = obj.CastShadow,
						Reflectance = obj.Reflectance,
					}
				end
	
				obj.Material = Enum.Material.SmoothPlastic
				obj.CastShadow = false
				obj.Reflectance = 0
	
				obj.TopSurface = Enum.SurfaceType.Smooth
				obj.BottomSurface = Enum.SurfaceType.Smooth
			end
	
			if obj:IsA("Texture") or obj:IsA("Decal") then
				if originalTextures[obj] == nil then
					originalTextures[obj] = obj.Transparency
				end
				obj.Transparency = 1
			end
	
			if obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
				if originalParticles[obj] == nil then
					originalParticles[obj] = obj.Enabled
				end
				obj.Enabled = false
			end
	
			if obj:IsA("MeshPart") then
				if originalMeshes[obj] == nil then
					originalMeshes[obj] = obj.TextureID
				end
				obj.TextureID = ""
			elseif obj:IsA("SpecialMesh") then
				if originalMeshes[obj] == nil then
					originalMeshes[obj] = obj.TextureId
				end
				obj.TextureId = ""
			end
		end
	end
	
	-- RESTORE EVERYTHING
	local function restoreAll()
		-- Lighting
		for k, v in pairs(originalLighting) do
			Lighting[k] = v
		end
	
		-- Restore sky
		if darkSky.Parent then
			darkSky.Parent = nil
		end
		if originalSky then
			originalSky.Parent = Lighting
		end
	
		-- Effects
		for obj, state in pairs(originalEffects) do
			if obj and obj.Parent then
				obj.Enabled = state
			end
		end
	
		-- Terrain
		if Terrain then
			pcall(function()
				if originalTerrainDecoration ~= nil then
					Terrain.Decoration = originalTerrainDecoration
				end
			end)
		end
	
		-- Parts
		for part, data in pairs(originalParts) do
			if part and part.Parent then
				part.Material = data.Material
				part.CastShadow = data.CastShadow
				part.Reflectance = data.Reflectance
			end
